{
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(black *)",
      "Bash(isort *)",
      "Bash(flake8 *)",
      "Bash(mypy *)",
      "Bash(bandit *)",
      "Bash(python -m mcp_server*)",
      "Bash(python3 -m mcp_server*)",
      "Bash(./ai-orchestrator *)",
      "Bash(make *)",
      "Bash(docker compose *)",
      "Bash(npm *)",
      "Bash(node *)",
      "Bash(wc *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)"
    ],
    "deny": ["Bash(rm -rf /)", "Bash(rm -rf ~)", "Bash(git push --force *)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path // .tool_input.filePath // empty' 2>/dev/null); if [ -n \"$file\" ] && echo \"$file\" | grep -qE '\\.py$'; then black --quiet \"$file\" 2>/dev/null; isort --quiet \"$file\" 2>/dev/null; fi"
          }
        ]
      }
    ]
  }
}
